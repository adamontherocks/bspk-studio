 "project": {
  "format": "bspk-studio-project",
  "id": "hemistitch-slava",
  "name": "Hemistitch + Slava donor",
  "title": "Hemistitch · Slava 5671 engine",
  "blurb": "Phase 1 of the fully mechanical plan: a Slava 5671 alarm-clock movement (Swiss lever, 18,000 beats an hour) is the engine. Its barrel, train, escapement and balance stay in its own plates; we tap its center arbor for our motion works and the two discs. Slava parts are bought, and their sizes are estimates from the 1987 factory manual until the clock arrives. Our parts are module 1 in 2.8 mm acrylic.",
  "source": [
   "Slava 5671: Shamonova, Repair of Mechanical Alarm Clocks (1987): 55.8 mm, 19 mm deep, 11 jewels, free (Swiss) lever, 15-tooth escape wheel, brass balance with a 0.4 s period, both springs in barrels, 36 h per wind, friction cannon pinion on the center arbor. Arbor positions are scaled from its Fig. 1 drawing; tooth counts and the balance diameter are guesses, to measure on the real one. Discs and motion works: VISION §10.8."
  ],
  "groups": {
   "donor": "Slava engine (bought)",
   "motion": "Motion works",
   "discs": "Discs"
  },
  "focus": [
   {
    "id": "donor",
    "label": "Slava engine: barrel → center → third → seconds → escape → balance",
    "parts": [
     "sl_barrel",
     "center",
     "sl_third",
     "sl_fourth",
     "sl_escape",
     "sl_fork",
     "sl_balance"
    ]
   },
   {
    "id": "motion",
    "label": "Motion works and discs: center → minute wheel → hour wheel",
    "parts": [
     "center",
     "mwheel",
     "hour",
     "minute_disc",
     "hour_disc"
    ]
   }
  ],
  "rules": {
   "minModule": 1,
   "fixedModule": true,
   "why": "the 1 mm end mill has to fit between the pinion teeth"
  },
  "rate": {
   "arbor": "center",
   "period": 3600,
   "dir": -1
  },
  "targets": [
   {
    "label": "Minute disc",
    "arbor": "center",
    "period": 3600,
    "dir": -1
   },
   {
    "label": "Hour disc",
    "arbor": "hour",
    "period": 43200,
    "dir": -1
   },
   {
    "label": "Seconds wheel (Slava)",
    "arbor": "sl_fourth",
    "period": 60,
    "dir": -1
   },
   {
    "label": "Escape wheel (Slava, 18,000 bph)",
    "arbor": "sl_escape",
    "period": 6,
    "dir": 1
   }
  ],
  "beat": {
   "gear": "sl_escape_wheel",
   "label": "Escape wheel (Slava)"
  },
  "arbors": [
   {
    "id": "sl_barrel",
